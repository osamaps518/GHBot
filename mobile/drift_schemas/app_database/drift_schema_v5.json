    {
      "name": "profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile\" (\"birth_year\" INTEGER NOT NULL, \"birth_month\" INTEGER NOT NULL, \"sex\" TEXT NOT NULL, \"height_cm\" REAL NOT NULL, \"weight_kg\" REAL NOT NULL, \"activity_level\" TEXT NOT NULL, \"goal\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "targets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"targets\" (\"calories\" INTEGER NOT NULL, \"protein_g\" INTEGER NOT NULL, \"fat_g\" INTEGER NOT NULL, \"carbs_g\" INTEGER NOT NULL, \"maintenance_calories\" INTEGER NOT NULL, \"at_minimum\" INTEGER NOT NULL CHECK (\"at_minimum\" IN (0, 1)), \"above_tested_age\" INTEGER NOT NULL CHECK (\"above_tested_age\" IN (0, 1)), \"goal\" TEXT NOT NULL, \"goal_adjustment_percent\" INTEGER NOT NULL, \"custom\" INTEGER NOT NULL CHECK (\"custom\" IN (0, 1)), \"macros_adjusted\" INTEGER NOT NULL CHECK (\"macros_adjusted\" IN (0, 1)), \"recommended_calories\" INTEGER NOT NULL, \"recommended_protein_g\" INTEGER NOT NULL, \"recommended_fat_g\" INTEGER NOT NULL, \"recommended_carbs_g\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "foods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foods\" (\"id\" TEXT NOT NULL, \"name_ar\" TEXT NULL, \"name_en\" TEXT NULL, \"calories_per_100g\" INTEGER NOT NULL, \"protein_per_100g\" INTEGER NOT NULL, \"carbs_per_100g\" INTEGER NOT NULL, \"fat_per_100g\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "food_log_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_log_entries\" (\"id\" TEXT NOT NULL, \"food_id\" TEXT NOT NULL, \"meal\" TEXT NOT NULL, \"meal_name\" TEXT NULL, \"diary_day\" TEXT NOT NULL, \"grams\" INTEGER NOT NULL, \"calories_per_100g\" INTEGER NOT NULL, \"protein_per_100g\" INTEGER NOT NULL, \"carbs_per_100g\" INTEGER NOT NULL, \"fat_per_100g\" INTEGER NOT NULL, \"calories\" INTEGER NOT NULL, \"protein\" INTEGER NOT NULL, \"carbs\" INTEGER NOT NULL, \"fat\" INTEGER NOT NULL, \"logged_at\" INTEGER NOT NULL, \"revision\" INTEGER NOT NULL DEFAULT 1, \"sent_revision\" INTEGER NOT NULL DEFAULT 0, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"refused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"refused\" IN (0, 1)), PRIMARY KEY (\"id\"));"
